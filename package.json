{
  "name": "gata-marketplace",
  "version": "0.1.0",
  "private": true,
  "description": "Gata: marketplace de servicii locale (meseriași și ajutor casnic) cu potrivire AI, oferte, recenzii și moderare. Next.js + Supabase + PostgreSQL/pgvector + OpenAI + MCP.",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "tsx --test \"tests/*.test.ts\"",
    "test:pg": "tsx --test --test-concurrency=1 \"tests/*.test.ts\"",
    "db:seed": "tsx scripts/seed.ts",
    "mcp": "node --import tsx mcp/server.ts",
    "mcp:smoke": "tsx scripts/mcp-smoke.ts",
    "matching:report": "tsx scripts/ranking-report.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@electric-sql/pglite-pgvector": "^0.0.9",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.4.0",
    "lucide-react": "^1.52.0",
    "motion": "^14.0.0",
    "next": "16.3.8",
    "next-themes": "^0.4.6",
    "openai": "^7.27.0",
    "postgres": "^3.4.9",
    "radix-ui": "^1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.32.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "shadcn": "^4.21.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
