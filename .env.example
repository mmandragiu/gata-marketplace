# Copy to .env.local and fill in what you need. Every variable is optional:
# with nothing set, the app runs in demo mode (embedded PostgreSQL, seeded at startup, local AI).

# --- Data mode -------------------------------------------------------------
# demo     = in-memory PostgreSQL (PGlite) with the same schema, RLS and triggers; resets on restart
# supabase = Supabase Auth + Realtime + PostgreSQL (needs the four Supabase variables below)
# If unset: "supabase" when DATABASE_URL, NEXT_PUBLIC_SUPABASE_URL and a key are present, otherwise "demo".
DATA_MODE=demo

# --- Supabase (Project Settings → API / Database) --------------------------
NEXT_PUBLIC_SUPABASE_URL=
# Either the publishable key (sb_publishable_…) or the legacy anon key.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Only used by `npm run db:seed` (creates the demo accounts). Never expose it to the browser.
SUPABASE_SERVICE_ROLE_KEY=
# Postgres connection string. On Vercel/serverless use the transaction pooler (port 6543).
DATABASE_URL=
# Set to "disable" for a local Postgres without TLS (localhost is detected automatically).
DB_SSL=
DB_POOL_MAX=5

# --- OpenAI (optional) -----------------------------------------------------
# Without a key the match score uses the local Romanian text similarity instead of embeddings + LLM.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# --- Demo / misc -------------------------------------------------------------
# Signs the demo-mode session cookie. Set a long random value on any public deployment.
DEMO_SESSION_SECRET=
# Password of the seeded accounts in Supabase mode (scripts/seed.ts).
DEMO_PASSWORD=Demo1234!
NEXT_PUBLIC_APP_NAME=Gata
